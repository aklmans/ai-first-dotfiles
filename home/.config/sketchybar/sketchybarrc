#!/bin/bash

# lib/theme.sh loads colors.sh and then theme.conf on top of it, so the whole
# look of the bar - palette, fonts, sizes, geometry - comes from those two files
# and nothing here is a number somebody has to find and change twice.
source "$CONFIG_DIR/lib/theme.sh"
source "$CONFIG_DIR/icons.sh" # Loads all defined icons

ITEM_DIR="$CONFIG_DIR/items" # Directory where the items are configured
PLUGIN_DIR="$CONFIG_DIR/plugins" # Directory where all the plugin scripts are stored

FONT="$THEME_FONT" # Needs Regular, Bold, Semibold, Heavy and Black variants
PADDINGS="$THEME_ITEM_PADDING" # All paddings use this value (icon, label, background)

# Unload the macOS on screen indicator overlay for volume change
launchctl unload -F /System/Library/LaunchAgents/com.apple.OSDUIHelper.plist > /dev/null 2>&1 &

# Setting up the general bar appearance of the bar
bar=(
  height=$THEME_BAR_HEIGHT
  color=$BAR_COLOR
  border_width=$THEME_BAR_BORDER_WIDTH
  border_color=$THEME_ACCENT_BAR_BORDER
  shadow=off
  position=top
  sticky=on
  padding_right=$THEME_BAR_PADDING
  padding_left=$THEME_BAR_PADDING
  y_offset=$THEME_BAR_Y_OFFSET
  margin=$THEME_BAR_MARGIN
  blur_radius=0
  corner_radius=$THEME_BAR_CORNER_RADIUS
  sticky=on
  notch_width=$THEME_BAR_NOTCH_WIDTH
  topmost=window
)

sketchybar --bar "${bar[@]}"

# Setting up default values
defaults=(
  updates=when_shown
  icon.font="$THEME_FONT_ICON"
  icon.color=$ICON_COLOR
  icon.padding_left=$PADDINGS
  icon.padding_right=$PADDINGS
  label.font="$THEME_FONT_LABEL"
  label.color=$LABEL_COLOR
  label.padding_left=$PADDINGS
  label.padding_right=$PADDINGS
  padding_right=$PADDINGS
  padding_left=$PADDINGS
  background.height=$THEME_ITEM_HEIGHT
  background.corner_radius=$THEME_ITEM_CORNER_RADIUS
  background.border_width=$THEME_ITEM_BORDER_WIDTH
  popup.background.border_width=$THEME_ITEM_BORDER_WIDTH
  popup.background.corner_radius=11
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.color=$POPUP_BACKGROUND_COLOR
  popup.blur_radius=20
  scroll_texts=on
)

sketchybar --default "${defaults[@]}"

# Left
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/aerospace_layout.sh"
source "$ITEM_DIR/front_app.sh"

# Center
source "$ITEM_DIR/spotify.sh"
source "$ITEM_DIR/media.sh"

# Right
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/ai_notifications.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/volume.sh"

sketchybar --hotload on

# Forcing all item scripts to run (never do this outside of sketchybarrc)
sketchybar --update

printf 'sketchybar configuration loaded (bar %spx, top inset %spx)\n' \
  "$THEME_BAR_HEIGHT" "$THEME_TOP_INSET"
