### AI Workflow Router runtime state
home/.config/ai-router/catalogs/
home/.config/ai-router/cache/
home/.config/ai-router/state/
home/.config/ai-router/logs/

### Privacy and local runtime artifacts
.env*
*.bak
*.backup*
**/cache/
**/logs/
**/state/
home/.config/zsh/private.zsh
home/.config/zsh/private.zprofile
# Your own aliases. aliases.zsh ships only what makes sense on any Mac; the
# project-, database- and application-specific ones live here and are never
# tracked or deployed. Start from aliases.local.zsh.example.
home/.config/zsh/aliases.local.zsh
# personal.zsh was shipped empty and deployed, so every update overwrote
# whatever had been written into it. It is no longer tracked or deployed;
# private.zsh is the file that survives updates.
home/.config/zsh/personal.zsh
**/__pycache__/
*.pyc

# macOS writes bytecode and app caches here. The patterns above do not catch it:
# they match lowercase "cache", not Apple's "Caches".
home/Library/Caches/

### Obsolete modules / local tool state
home/.config/skhd/
home/.config/yabai/
home/.config/wezterm/
home/.config/oh-my-posh/
bootstrap/install/warp-launch-agent.sh
home/.config/aerospace/warp-launch-agent.sh

# Warp saved-tab layouts are session state, not configuration: each one pins an
# absolute directory and a tab name taken from whoever created it, so it cannot
# work on another machine and it publishes a username. Warp rewrites this
# directory as you use it.
home/.warp/tab_configs/
